# Copy to .env and edit, then `docker compose up -d`.
# TrueNAS Custom Apps don't read .env files; use deploy/truenas.yaml there.

# Host path of your music library (mounted read-write at /music - the
# duplicate finder's quarantine and the m3u fixer both need write access;
# everything else only ever talks to Navidrome's API, not the filesystem).
MUSIC_PATH=/path/to/music
# Host path for app state: quarantine manifest, tag cache, worship artist
# list, playlist folder map, job schedules, run history.
CONFIG_PATH=./config
# Host port for the web UI.
PORT=8095
# User/group that owns your music files (`id -u`, `id -g`). On TrueNAS
# SCALE, apps commonly run as a svc_apps service account - check yours with
# `id svc_apps` rather than assuming 3000:3000.
PUID=1000
PGID=1000
TZ=UTC

# --- Auth (required by default) -----------------------------------------
# This app holds your Navidrome admin password and can permanently delete
# library files, so Basic Auth is on by default. Set AUTH_DISABLED=1 only if
# you're putting your own auth proxy in front of it instead.
AUTH_USER=
AUTH_PASS=
AUTH_DISABLED=
# Hostnames you reach the UI by, if they're real domain names (e.g. a reverse
# proxy at toolkit.example.com). IPs, single-word names and .local/.lan/
# .home.arpa names always work. Comma-separated.
ALLOWED_HOSTS=

# --- Navidrome -------------------------------------------------------------
# The same user AudioMuse logs in as - cluster cleanup, Tidarr tagging and
# playlist folders all act as this user, and can only edit playlists it owns
# (or that you're an admin over).
ND_URL=http://change-me:4533
ND_USER=
ND_PASS=

# --- AudioMuse-AI -----------------------------------------------------------
AUDIOMUSE_URL=http://change-me:8000
# From AudioMuse's Setup Wizard.
AUDIOMUSE_API_TOKEN=

# --- Replicate (AI playlist cover art) --------------------------------------
# From https://replicate.com/account/api-tokens - generate a real token, not
# one of Replicate's short-lived "getting started" demo tokens. Only needed
# for AI-mode covers; template mode (curated backgrounds + typography) needs
# neither.
REPLICATE_API_TOKEN=
# An "owner/name" official-model id - Replicate always runs that model's
# latest version, so there's no version hash to track. google/imagen-4 is
# photorealistic (~$0.04/image); google/imagen-4-fast is the same family at
# roughly half the price (~$0.02/image) and is "good enough" for most covers;
# black-forest-labs/flux-dev (~$0.025/image) is a non-Google alternative.
# Check https://replicate.com/pricing for current numbers.
REPLICATE_MODEL=google/imagen-4

# --- Duplicate finder tuning (unchanged from docker-music-dupes) ----------
# When two copies are otherwise equal, keep the one from these sources first
# (comma-separated, matched against the Source label). Empty turns it off.
PREFER_SOURCES=Tidarr
# When editions are otherwise equal, keep the remastered one. false prefers originals.
PREFER_REMASTERS=true
# Acoustic fingerprints (fpcalc) of every file in a duplicate group, full length.
# report: show what they find and what they'd change, decide without them.
# on: let them confirm or veto duplicates. off: skip them.
FINGERPRINT=report
# Parallel fpcalc processes. Empty uses every CPU the container is allowed.
FINGERPRINT_WORKERS=
# Optional: label each file with the download client Lidarr imported it from.
LIDARR_URL=
LIDARR_API_KEY=
LIDARR_MUSIC_ROOT=/data/media/music

# Image to run. Change if you publish your own fork.
# IMAGE=ghcr.io/mikestecker/docker-homelab-music-toolkit:latest
